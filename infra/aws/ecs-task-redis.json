{
  "family": "solr-redis",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "768",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn":      "arn:aws:iam::ACCOUNT_ID:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "redis",
      "image": "ghcr.io/codeyogico/solr-experiments/redis:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 6379, "protocol": "tcp", "name": "redis" }
      ],
      "secrets": [
        {
          "name": "REDIS_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:solr/redis-password"
        }
      ],
      "command": [
        "redis-server",
        "/usr/local/etc/redis/redis.conf",
        "--requirepass", "$(REDIS_PASSWORD)"
      ],
      "mountPoints": [
        {
          "sourceVolume": "redis-data",
          "containerPath": "/data",
          "readOnly": false
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":         "/ecs/solr-redis",
          "awslogs-region":        "us-east-1",
          "awslogs-stream-prefix": "redis",
          "awslogs-create-group":  "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "redis-cli ping | grep PONG || exit 1"],
        "interval": 15,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 15
      }
    }
  ],
  "volumes": [
    {
      "name": "redis-data",
      "efsVolumeConfiguration": {
        "fileSystemId": "EFS_FILESYSTEM_ID",
        "rootDirectory": "/redis/data",
        "transitEncryption": "ENABLED"
      }
    }
  ]
}
