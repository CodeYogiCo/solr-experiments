{
  "family": "solr-zookeeper",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn":      "arn:aws:iam::ACCOUNT_ID:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "zookeeper",
      "image": "ghcr.io/codeyogico/solr-experiments/zookeeper:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 2181, "protocol": "tcp", "name": "client" },
        { "containerPort": 2888, "protocol": "tcp", "name": "follower" },
        { "containerPort": 3888, "protocol": "tcp", "name": "election" }
      ],
      "environment": [
        { "name": "ZOO_MY_ID",                  "value": "1" },
        { "name": "ZOO_4LW_COMMANDS_WHITELIST",  "value": "mntr,conf,ruok,srvr,stat" }
      ],
      "mountPoints": [
        {
          "sourceVolume": "zookeeper-data",
          "containerPath": "/data",
          "readOnly": false
        },
        {
          "sourceVolume": "zookeeper-datalog",
          "containerPath": "/datalog",
          "readOnly": false
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":         "/ecs/solr-zookeeper",
          "awslogs-region":        "us-east-1",
          "awslogs-stream-prefix": "zookeeper",
          "awslogs-create-group":  "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "echo ruok | nc -w 2 localhost 2181 | grep imok || exit 1"],
        "interval": 15,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 30
      }
    }
  ],
  "volumes": [
    {
      "name": "zookeeper-data",
      "efsVolumeConfiguration": {
        "fileSystemId": "EFS_FILESYSTEM_ID",
        "rootDirectory": "/zookeeper/data",
        "transitEncryption": "ENABLED"
      }
    },
    {
      "name": "zookeeper-datalog",
      "efsVolumeConfiguration": {
        "fileSystemId": "EFS_FILESYSTEM_ID",
        "rootDirectory": "/zookeeper/datalog",
        "transitEncryption": "ENABLED"
      }
    }
  ]
}
