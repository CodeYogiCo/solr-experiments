{
  "family": "solr",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn":      "arn:aws:iam::ACCOUNT_ID:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "solr",
      "image": "ghcr.io/codeyogico/solr-experiments/solr:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 8983, "protocol": "tcp", "name": "http" }
      ],
      "environment": [
        { "name": "SOLR_HEAP", "value": "2g" },
        { "name": "ZK_HOST",   "value": "ZOOKEEPER_SERVICE_DISCOVERY_URL:2181" }
      ],
      "secrets": [
        {
          "name": "REDIS_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:solr/redis-password"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "solr-data",
          "containerPath": "/var/solr/data",
          "readOnly": false
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":         "/ecs/solr",
          "awslogs-region":        "us-east-1",
          "awslogs-stream-prefix": "solr",
          "awslogs-create-group":  "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -sf http://localhost:8983/solr/admin/info/system || exit 1"],
        "interval": 30,
        "timeout": 10,
        "retries": 5,
        "startPeriod": 90
      }
    }
  ],
  "volumes": [
    {
      "name": "solr-data",
      "efsVolumeConfiguration": {
        "fileSystemId": "EFS_FILESYSTEM_ID",
        "rootDirectory": "/solr/data",
        "transitEncryption": "ENABLED"
      }
    }
  ]
}
