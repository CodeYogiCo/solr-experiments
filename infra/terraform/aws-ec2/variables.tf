variable "aws_region"           { default = "us-east-1" }
variable "name"                 { default = "solr-stack" }
variable "vpc_cidr"             { default = "10.0.0.0/16" }
variable "admin_cidr"           { description = "Your IP for SSH access, e.g. 1.2.3.4/32" }
variable "ssh_public_key"       { description = "SSH public key content" }
variable "solr_instance_type"   { default = "r6i.xlarge"  }
variable "redis_instance_type"  { default = "r6i.large"   }
variable "image_tag"            { default = "latest" }
variable "image_repo"           { default = "codeyogico/solr-experiments" }
variable "registry"             { default = "ghcr.io" }
