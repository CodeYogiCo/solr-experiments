variable "location"        { default     = "eastus" }
variable "name"            { default     = "solr-stack" }
variable "admin_cidr"      { description = "Your IP for SSH, e.g. 1.2.3.4/32" }
variable "admin_username"  { default     = "azureuser" }
variable "ssh_public_key"  { description = "SSH public key content" }
variable "solr_vm_size"    { default     = "Standard_D4s_v3" }
variable "redis_vm_size"   { default     = "Standard_D2s_v3" }
variable "image_tag"       { default     = "latest" }
variable "image_repo"      { default     = "codeyogico/solr-experiments" }
variable "registry"        { default     = "ghcr.io" }
