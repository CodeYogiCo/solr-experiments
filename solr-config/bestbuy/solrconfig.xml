<?xml version="1.0" encoding="UTF-8" ?>
<config>
  <luceneMatchVersion>9.0</luceneMatchVersion>

  <!-- ── Lib: Redis plugin ────────────────────────────────────────────────── -->
  <lib dir="${solr.install.dir}/server/solr/lib" regex="solr-redis-plugin-.*\.jar"/>

  <!-- ── Data directories ────────────────────────────────────────────────── -->
  <dataDir>${solr.data.dir:}</dataDir>
  <directoryFactory name="DirectoryFactory" class="${solr.directoryFactory:solr.NRTCachingDirectoryFactory}"/>
  <codecFactory class="solr.SchemaCodecFactory"/>

  <!-- ── Index settings ──────────────────────────────────────────────────── -->
  <indexConfig>
    <lockType>${solr.lock.type:native}</lockType>
    <infoStream>false</infoStream>
    <mergePolicyFactory class="org.apache.solr.index.TieredMergePolicyFactory">
      <int  name="maxMergeAtOnce">10</int>
      <int  name="segmentsPerTier">10</int>
      <bool name="deletesPctAllowed">true</bool>
    </mergePolicyFactory>
  </indexConfig>

  <!-- ── JMX ─────────────────────────────────────────────────────────────── -->
  <jmx/>

  <!-- ── Update handler ──────────────────────────────────────────────────── -->
  <updateHandler class="solr.DirectUpdateHandler2">
    <updateLog>
      <str name="dir">${solr.ulog.dir:}</str>
      <int name="numVersionBuckets">65536</int>
    </updateLog>
    <autoCommit>
      <maxTime>${solr.autoCommit.maxTime:15000}</maxTime>
      <openSearcher>false</openSearcher>
    </autoCommit>
    <autoSoftCommit>
      <maxTime>${solr.autoSoftCommit.maxTime:3000}</maxTime>
    </autoSoftCommit>
  </updateHandler>

  <!-- ── Query settings ──────────────────────────────────────────────────── -->
  <query>
    <maxBooleanClauses>${solr.max.booleanClauses:1024}</maxBooleanClauses>
    <filterCache size="512" initialSize="512" autowarmCount="128"/>
    <queryResultCache size="512" initialSize="512" autowarmCount="128"/>
    <documentCache size="512" initialSize="512" autowarmCount="0"/>
    <enableLazyFieldLoading>true</enableLazyFieldLoading>
    <queryResultWindowSize>20</queryResultWindowSize>
    <queryResultMaxDocsCached>200</queryResultMaxDocsCached>
    <slowQueryThresholdMillis>1000</slowQueryThresholdMillis>
  </query>

  <!-- ── Redis store availability component ──────────────────────────────── -->
  <searchComponent name="storeAvailability"
                   class="com.solrexperiments.redis.RedisStoreAvailabilityComponent">
    <str  name="redis.host">${redis.host:redis}</str>
    <int  name="redis.port">${redis.port:6379}</int>
    <str  name="redis.password">${redis.password:}</str>
    <int  name="redis.timeout">${redis.timeout:2000}</int>
    <int  name="redis.pool.maxTotal">${redis.pool.maxTotal:16}</int>
    <int  name="redis.pool.maxIdle">${redis.pool.maxIdle:8}</int>
  </searchComponent>

  <!-- ── Request handlers ─────────────────────────────────────────────────── -->
  <requestHandler name="/select" class="solr.SearchHandler">
    <lst name="defaults">
      <str name="echoParams">explicit</str>
      <int name="rows">20</int>
      <str name="df">name</str>
      <str name="defType">edismax</str>
      <str name="qf">name^3.0 shortDescription^1.5 manufacturer^1.2 description^1.0</str>
      <str name="pf">name^5.0</str>
      <str name="fl">id,sku,name,manufacturer,regularPrice,salePrice,onSale,
                      customerReviewAverage,customerReviewCount,categoryLeaf,
                      thumbnailImage,url,onlineAvailability,inStoreAvailability</str>
    </lst>
    <arr name="last-components">
      <str>storeAvailability</str>
    </arr>
  </requestHandler>

  <!-- Suggest handler for autocomplete -->
  <requestHandler name="/suggest" class="solr.SearchHandler" startup="lazy">
    <lst name="defaults">
      <str name="suggest">true</str>
      <str name="suggest.count">10</str>
      <str name="suggest.dictionary">suggestDictionary</str>
    </lst>
    <arr name="components">
      <str>suggest</str>
    </arr>
  </requestHandler>

  <searchComponent name="suggest" class="solr.SuggestComponent">
    <lst name="suggester">
      <str name="name">suggestDictionary</str>
      <str name="lookupImpl">FuzzyLookupFactory</str>
      <str name="dictionaryImpl">DocumentDictionaryFactory</str>
      <str name="field">suggest</str>
      <str name="weightField">customerReviewCount</str>
      <str name="suggestAnalyzerFieldType">text_suggest</str>
      <bool name="buildOnStartup">false</bool>
      <bool name="buildOnCommit">true</bool>
    </lst>
  </searchComponent>

  <!-- Update handler -->
  <requestHandler name="/update" class="solr.UpdateRequestHandler"/>

  <!-- Admin handlers -->
  <requestHandler name="/admin/ping" class="solr.PingRequestHandler">
    <lst name="invariants">
      <str name="q">*:*</str>
      <str name="rows">0</str>
    </lst>
    <lst name="defaults">
      <str name="echoParams">all</str>
    </lst>
  </requestHandler>

</config>
