# ── Solr ──────────────────────────────────────────────────────────────────────
SOLR_HEAP=2g
SOLR_PORT=8983
SOLR_COLLECTION=bestbuy
SOLR_REPLICATION_FACTOR=2
SOLR_NUM_SHARDS=2
SOLR_MAX_SHARDS_PER_NODE=2

# ── ZooKeeper ─────────────────────────────────────────────────────────────────
ZK_CLIENT_PORT=2181
ZK_TICK_TIME=2000
ZK_INIT_LIMIT=10
ZK_SYNC_LIMIT=5

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_MAX_MEMORY=512mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru

# ── Best Buy API (optional – for live data pull) ───────────────────────────────
BESTBUY_API_KEY=

# ── Image registry ────────────────────────────────────────────────────────────
IMAGE_REGISTRY=ghcr.io
IMAGE_REPO=codeyogico/solr-experiments
IMAGE_TAG=latest

# ── Cloud deploy (set the one you need) ───────────────────────────────────────
# AWS
AWS_REGION=us-east-1
AWS_ECS_CLUSTER=solr-cluster

# GCP
GCP_PROJECT_ID=
GCP_REGION=us-central1

# Azure
AZURE_RESOURCE_GROUP=
AZURE_ACS_CLUSTER=
